			"Enabled": true
		},
		{
			"Name": "ContentBrowserAssetDataSource",
			"Enabled": true,
			"TargetAllowList": ["Editor"]
		},
		{
			"Name": "ContentBrowserClassDataSource",
			"Enabled": true,
			"TargetAllowList": ["Editor"]
		},
		{
			"Name": "EngineAssetDefinitions",
			"Enabled": true,
			"TargetAllowList": ["Editor"]
		},
		{
			"Name": "PluginBrowser",
			"Enabled": true,
			"TargetAllowList": ["Editor"]
		},
		{
			"Name": "VisualStudioSourceCodeAccess",
			"Enabled": true,
			"PlatformAllowList": ["Win64"],
			"TargetAllowList": ["Editor"]
		}
	]
}
